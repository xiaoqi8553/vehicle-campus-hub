generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                       String          @id @default(cuid())
  slug                     String?         @unique
  name                     String          @unique
  shortName                String?
  type                     String?
  logo                     String?
  category                 String
  description              String
  officialWebsite          String?
  recruitmentWebsite       String?
  campusRecruitmentWebsite String?
  campusUrl                String?
  sourceUrl                String?
  sourceType               String          @default("UNKNOWN")
  verifiedAt               DateTime?
  dateConfidence           String          @default("UNKNOWN")
  changeSummary            String?
  cities                   String          @default("[]")
  tags                     String          @default("[]")
  vehicleDirections        String          @default("[]")
  fitDirections            String          @default("[]")
  status                   String          @default("待确认")
  dataStatus               String          @default("待核实")
  lastVerifiedAt           DateTime?
  lastUpdatedAt            DateTime        @default(now())
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  recruitments             Recruitment[]
  jobs                     Job[]
  resources                Resource[]
  calendarEvents           CalendarEvent[]
  links                    CompanyLink[]
  favorites                Favorite[]
}

model CompanyLink {
  id              String   @id @default(cuid())
  companyId       String
  title           String
  url             String
  finalUrl        String?
  sourceType      String
  targetCohort    String
  verifiedAt      DateTime?
  healthStatus    String
  evidenceSummary String
  isPrimary       Boolean  @default(false)
  httpStatus      Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruitments    Recruitment[]

  @@index([companyId])
  @@index([healthStatus])
  @@unique([companyId, url])
}

model Recruitment {
  id             String          @id @default(cuid())
  companyId      String
  year           Int
  targetYear     Int?
  season         String
  batch          String?
  title          String
  status         String
  startDate      DateTime?
  endDate        DateTime?
  applyUrl       String?
  process        String
  note           String?
  notes          String?
  sourceUrl      String?
  sourceType     String          @default("UNKNOWN")
  verifiedAt     DateTime?
  dateConfidence String          @default("UNKNOWN")
  changeSummary  String?
  credibility    String
  sourceLinkId   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceLink     CompanyLink?    @relation(fields: [sourceLinkId], references: [id], onDelete: SetNull)
  jobs           Job[]
  calendarEvents CalendarEvent[]

  @@index([companyId])
  @@index([sourceLinkId])
}

model Job {
  id               String       @id @default(cuid())
  companyId        String
  recruitmentId    String?
  programId        String?
  title            String
  direction        String
  city             String
  education        String
  majorRequirement String
  majors           String       @default("[]")
  skills           String       @default("[]")
  applyUrl         String?
  sourceUrl        String?
  sourceType       String       @default("UNKNOWN")
  verifiedAt       DateTime?
  dateConfidence   String       @default("UNKNOWN")
  changeSummary    String?
  vehicleFitScore  Int
  matchScore       Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruitment      Recruitment? @relation(fields: [recruitmentId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([recruitmentId])
}

model Resource {
  id             String    @id @default(cuid())
  companyId      String?
  title          String
  type           String
  targetYear     Int?
  sourceYear     Int?
  url            String?
  sourceUrl      String?
  source         String
  sourceType     String?
  verifiedAt     DateTime?
  dateConfidence String    @default("UNKNOWN")
  changeSummary  String?
  summary        String
  content        String    @default("[]")
  credibility    String
  tags           String    @default("[]")
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  company        Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  nickname  String?
  role      String     @default("USER")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  favorites Favorite[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

model CalendarEvent {
  id            String       @id @default(cuid())
  companyId     String
  recruitmentId String?
  programId     String?
  title         String
  eventType     String
  eventDate     DateTime?
  status        String
  sourceUrl     String?
  sourceType    String       @default("UNKNOWN")
  verifiedAt    DateTime?
  dateConfidence String      @default("UNKNOWN")
  changeSummary String?
  credibility   String       @default("待核实")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruitment   Recruitment? @relation(fields: [recruitmentId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([recruitmentId])
  @@index([eventDate])
}
