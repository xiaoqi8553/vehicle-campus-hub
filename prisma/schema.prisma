generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id                       String          @id @default(cuid())
  slug                     String?         @unique
  name                     String          @unique
  shortName                String?
  type                     String?
  logo                     String?
  category                 String
  description              String
  officialWebsite          String?
  campusRecruitmentWebsite String?
  campusUrl                String?
  cities                   String          @default("[]")
  tags                     String          @default("[]")
  vehicleDirections        String          @default("[]")
  fitDirections            String          @default("[]")
  status                   String          @default("待确认")
  dataStatus               String          @default("待核实")
  lastVerifiedAt           DateTime?
  lastUpdatedAt            DateTime        @default(now())
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  recruitments             Recruitment[]
  jobs                     Job[]
  resources                Resource[]
  calendarEvents           CalendarEvent[]
  favorites                Favorite[]
}

model Recruitment {
  id             String          @id @default(cuid())
  companyId      String
  year           Int
  targetYear     Int?
  season         String
  batch          String?
  title          String
  status         String
  startDate      DateTime?
  endDate        DateTime?
  applyUrl       String?
  process        String
  note           String?
  notes          String?
  sourceUrl      String?
  sourceType     String?
  credibility    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobs           Job[]
  calendarEvents CalendarEvent[]

  @@index([companyId])
}

model Job {
  id               String       @id @default(cuid())
  companyId        String
  recruitmentId    String?
  programId        String?
  title            String
  direction        String
  city             String
  education        String
  majorRequirement String
  majors           String       @default("[]")
  skills           String       @default("[]")
  applyUrl         String?
  vehicleFitScore  Int
  matchScore       Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruitment      Recruitment? @relation(fields: [recruitmentId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([recruitmentId])
}

model Resource {
  id             String    @id @default(cuid())
  companyId      String
  title          String
  type           String
  targetYear     Int?
  sourceYear     Int?
  url            String?
  sourceUrl      String?
  source         String
  sourceType     String?
  summary        String
  credibility    String
  tags           String    @default("[]")
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  nickname  String?
  role      String     @default("USER")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  favorites Favorite[]
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

model CalendarEvent {
  id            String       @id @default(cuid())
  companyId     String
  recruitmentId String?
  programId     String?
  title         String
  eventType     String
  eventDate     DateTime
  status        String
  sourceUrl     String?
  credibility   String       @default("待核实")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recruitment   Recruitment? @relation(fields: [recruitmentId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([recruitmentId])
  @@index([eventDate])
}
