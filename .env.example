# Runtime connection. Use the Neon pooled connection string in Vercel.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/vehicle_campus_hub?schema=public"

# Migration connection. Use the Neon direct connection string in CI/production.
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/vehicle_campus_hub?schema=public"

# Production admin routes remain disabled unless explicitly enabled.
ADMIN_ENABLED="false"

# Required by database backup workflows after Neon is connected.
NEON_PROJECT_ID=""
NEON_API_KEY=""
