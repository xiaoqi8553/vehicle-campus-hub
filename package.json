{
  "name": "vehicle-campus-hub",
  "version": "2.1.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "data:refresh-resources": "tsx prisma/refresh-resources.ts",
    "db:migrate:sqlite": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "db:verify": "tsx scripts/verify-database.ts",
    "db:backup": "tsx scripts/create-neon-restore-point.ts",
    "check:utf8": "node scripts/check-utf8.mjs",
    "check": "npm run check:utf8 && npm run format:check && npm run lint && npm run typecheck && npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:smoke": "tsx scripts/production-smoke.ts"
  },
  "overrides": {
    "postcss": "8.5.18"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.17.0",
    "next": "^15.5.19",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.19",
    "pg": "^8.21.0",
    "postcss": "8.5.18",
    "prettier": "^3.8.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
